{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/verification-adapter.schema.json",
  "title": "Project verification adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter_id", "title", "description", "ownership", "command", "applies_to", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "ownership": { "const": "ADAPTER" },
    "command": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "required_fields"],
      "properties": {
        "format": { "enum": ["json", "text"] },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    }
  }
}
