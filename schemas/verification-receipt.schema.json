{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/verification-receipt.schema.json",
  "title": "SISO Project OS Independent Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "unit_id", "attempt", "actor", "verifier", "verifier_role", "candidate_sha", "base_sha", "checks", "changed_files", "write_fence_verdict", "outside_write_fence", "overall", "evidence_refs", "verified_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "unit_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "verifier_role": { "type": "string", "minLength": 1 },
    "candidate_sha": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "changed_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "write_fence_verdict": { "type": "string", "enum": ["passed", "failed"] },
    "outside_write_fence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "overall": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "verified_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "status", "exit_code", "duration_ms", "evidence_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
