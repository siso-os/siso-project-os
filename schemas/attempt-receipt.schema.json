{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/attempt-receipt.schema.json",
  "title": "SISO Project OS Worktree Attempt Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "unit_id", "attempt", "task_ids", "base_sha", "revalidated_base_sha", "checkout_sha", "detached", "clean", "worktree_ref", "prerequisites", "status", "created_at", "created_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "unit_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "base_sha": { "type": "string", "minLength": 1 },
    "revalidated_base_sha": { "type": "string", "minLength": 1 },
    "checkout_sha": { "type": "string", "minLength": 1 },
    "detached": { "type": "boolean" },
    "clean": { "type": "boolean" },
    "worktree_ref": { "type": "string", "minLength": 1 },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mode", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["present", "linked", "copied", "generated", "not_required"] },
          "status": { "type": "string", "enum": ["passed", "blocked"] }
        }
      }
    },
    "status": { "type": "string", "enum": ["ready", "blocked"] },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
      "then": { "properties": { "detached": { "const": true }, "clean": { "const": true } } }
    }
  ]
}
