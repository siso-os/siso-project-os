{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/project-profile.schema.json",
  "title": "Project capability profile",
  "description": "The engine-neutral entry point for a permanently installed Project OS capability profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "title",
    "description",
    "capability_root",
    "canonical_operator",
    "operator_authority",
    "capability_manifests",
    "agent_profiles",
    "commands",
    "verification_adapters",
    "bridges",
    "discovery"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "const": "full" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capability_root": { "const": ".agents" },
    "canonical_operator": { "const": ".agents/skills/project-operator/SKILL.md" },
    "operator_authority": { "const": ".agents/skills/project-operator/OPERATOR.html" },
    "capability_manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.agents/capabilities/.+\\.json$" }
    },
    "agent_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.agents/agents/.+\\.json$" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.agents/commands/.+\\.json$" }
    },
    "verification_adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.agents/adapters/.+\\.json$" }
    },
    "bridges": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["engine", "path", "canonical"],
        "properties": {
          "engine": { "enum": ["claude", "codex"] },
          "path": { "enum": ["AGENTS.md", "CLAUDE.md"] },
          "canonical": { "const": ".agents/skills/project-operator/SKILL.md" }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files_per_root", "max_total_files", "max_file_bytes", "max_depth"],
      "properties": {
        "max_files_per_root": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "max_total_files": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_file_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    }
  }
}
