{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/run-queue.schema.json",
  "title": "SISO Project OS Run Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "revision", "updated_at", "units", "packet_digests"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
    "packet_digests": { "type": "array", "items": { "$ref": "#/$defs/packetDigest" } }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_ids", "status", "depends_on", "packet_path", "write_fence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
        "status": { "type": "string", "enum": ["ready", "assigned", "running", "returned", "landed", "blocked", "failed", "cancelled"] },
        "assignee": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "packet_path": { "type": "string", "minLength": 1 },
        "return_path": { "type": "string", "minLength": 1 },
        "write_fence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "packetDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
