{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/fleet-callback.schema.json",
  "title": "SISO Project OS Fleet Callback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "recorded_at", "from", "to", "event", "status", "task_ids", "evidence_refs", "ack_required"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^CALLBACK-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "enum": ["checkpoint", "heartbeat", "handoff", "blocked", "completion", "verification", "recovery"] },
    "status": { "type": "string", "enum": ["queued", "delivered", "acknowledged", "failed", "superseded"] },
    "task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "message": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "ack_required": { "type": "boolean" },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "acknowledged_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
