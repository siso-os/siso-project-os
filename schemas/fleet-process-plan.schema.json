{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/fleet-process-plan.schema.json",
  "title": "SISO Project OS Fleet Process Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "workspace", "durable_identity_field", "volatile_identity_fields", "callback_transport", "admission_receipt_authority", "process_start_authority", "required_start_revalidation", "compute_profiles", "roles"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "durable_identity_field": { "const": "terminal_id" },
    "volatile_identity_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "callback_transport": { "type": "string", "minLength": 1 },
    "admission_receipt_authority": { "const": "eligibility-only" },
    "process_start_authority": { "const": "provider-atomic-compare-and-start" },
    "required_start_revalidation": { "const": ["active-work-claims", "provider-live-assignments", "verifier-backlog", "machine-thresholds"] },
    "compute_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "worker"],
      "properties": {
        "lead": { "$ref": "#/$defs/computeProfile" },
        "worker": { "$ref": "#/$defs/computeProfile" }
      }
    },
    "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } }
  },
  "$defs": {
    "computeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "const": "max" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "contract", "lifecycle", "profile", "compute_profile", "reasoning_effort", "machine_roles"],
      "properties": {
        "role_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "contract": { "type": "string", "enum": ["sol-goal", "luna-task", "project-os-role"] },
        "lifecycle": { "type": "string", "enum": ["long-running", "task-scoped", "event-driven"] },
        "profile": { "type": "string", "minLength": 1 },
        "compute_profile": { "type": "string", "enum": ["lead", "worker"] },
        "reasoning_effort": { "const": "max" },
        "machine_roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
      }
    }
  }
}
