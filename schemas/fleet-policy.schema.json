{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/fleet-policy.schema.json",
  "title": "SISO Project OS Fleet Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capacity", "heartbeat", "admission", "qualification", "machines"],
  "properties": {
    "schema_version": { "const": 1 },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_live", "verifier_ratio", "verifier_reserve", "max_pending_verifications"],
      "properties": {
        "max_live": { "type": "integer", "minimum": 2 },
        "verifier_ratio": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "verifier_reserve": { "type": "integer", "minimum": 1 },
        "max_pending_verifications": { "type": "integer", "minimum": 1 }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stale_after_seconds", "recovery_requires_checkpoint"],
      "properties": {
        "stale_after_seconds": { "type": "integer", "minimum": 30 },
        "recovery_requires_checkpoint": { "const": true }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_clean_worktree", "require_evidence_path", "require_repository_boundary"],
      "properties": {
        "require_clean_worktree": { "const": true },
        "require_evidence_path": { "const": true },
        "require_repository_boundary": { "const": true }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_verifier", "require_candidate_sha", "require_evidence_refs"],
      "properties": {
        "independent_verifier": { "const": true },
        "require_candidate_sha": { "const": true },
        "require_evidence_refs": { "const": true }
      }
    },
    "machines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/machine" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host_class", "roles", "max_live", "thresholds"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "host_class": { "type": "string", "enum": ["macbook", "mac-mini", "linux", "cloud", "other"] },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "max_live": { "type": "integer", "minimum": 1 },
        "preference": { "type": "integer", "minimum": 1 },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_available_disk_bytes", "minimum_available_memory_bytes", "maximum_load_per_cpu", "require_ac_power"],
          "properties": {
            "minimum_available_disk_bytes": { "type": "integer", "minimum": 1 },
            "minimum_available_memory_bytes": { "type": "integer", "minimum": 1 },
            "maximum_load_per_cpu": { "type": "number", "minimum": 0.01 },
            "require_ac_power": { "type": "boolean" }
          }
        }
      }
    }
  }
}
