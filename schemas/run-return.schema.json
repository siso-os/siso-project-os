{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/run-return.schema.json",
  "title": "SISO Project OS Worker or Lane Return",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "scope", "sprint_id", "run_id", "lane_id", "unit_id", "packet_id", "actor", "role", "status", "summary", "candidate_sha", "evidence_refs", "result_ref", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^RETURN-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "scope": { "type": "string", "enum": ["sprint_lane", "run_unit"] },
    "sprint_id": { "type": ["string", "null"], "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "lane_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "unit_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "packet_id": { "type": ["string", "null"], "pattern": "^PACKET-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "actor": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["passed", "blocked", "failed", "cancelled"] },
    "summary": { "type": "string", "minLength": 1 },
    "candidate_sha": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "result_ref": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": { "properties": { "candidate_sha": { "type": "string", "minLength": 1 }, "evidence_refs": { "minItems": 1 } } }
    }
  ]
}
