{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/lane-packet.schema.json",
  "title": "SISO Project OS Sprint Lane Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sprint_id", "lane_id", "objective", "owner", "task_ids", "write_fence", "depends_on", "created_at", "created_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "sprint_id": { "type": "string", "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "lane_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "write_fence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  }
}
