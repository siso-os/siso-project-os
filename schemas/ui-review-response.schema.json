{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/ui-review-response.schema.json",
  "title": "UI Lab review response",
  "description": "Raw human response imported from a deterministic campaign review projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "task_id", "candidate_manifest", "candidate_manifest_sha256", "selected_direction_id", "rejected_direction_ids", "reviewer", "recorded_at", "rationale", "verbatim_notes"],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "pattern": "^UI-[0-9]{4}$" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{4}$" },
    "candidate_manifest": { "$ref": "#/$defs/relativePath" },
    "candidate_manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "selected_direction_id": { "$ref": "#/$defs/directionId" },
    "rejected_direction_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/directionId" } },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string", "minLength": 1 },
    "verbatim_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "directionId": { "type": "string", "pattern": "^DIR-[A-Z0-9][A-Z0-9-]*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+" }
  }
}
