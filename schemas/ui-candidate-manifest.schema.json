{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/ui-candidate-manifest.schema.json",
  "title": "UI Lab candidate manifest",
  "description": "Bounded authored inventory of comparable candidate artifacts for one task-linked campaign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "task_id", "source_revision", "comparison_contract", "candidates"],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "pattern": "^UI-[0-9]{4}$" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{4}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "comparison_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_ids", "copy_fixture", "data_fixture", "shell", "viewports"],
      "properties": {
        "screen_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "copy_fixture": { "$ref": "#/$defs/relativePath" },
        "data_fixture": { "$ref": "#/$defs/relativePath" },
        "shell": { "$ref": "#/$defs/relativePath" },
        "viewports": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/viewport" } }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "direction_id", "title", "summary", "eligibility", "artifact"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAN-[A-Z0-9][A-Z0-9-]*$" },
          "direction_id": { "type": "string", "pattern": "^DIR-[A-Z0-9][A-Z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1 },
          "eligibility": { "type": "string", "enum": ["review_candidate", "study_only"] },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "media_type"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "alt": { "type": "string" }
            }
          },
          "generation_receipt": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 240 },
        "height": { "type": "integer", "minimum": 240 }
      }
    }
  }
}
