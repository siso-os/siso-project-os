{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/landing-receipt.schema.json",
  "title": "SISO Project OS Landing Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_id", "run_id", "unit_id", "candidate_sha", "pre_sha", "post_sha", "remote_sha", "integrator", "verifier", "verification_receipt", "gate_receipts", "push_policy", "remote_equality", "rollback", "disposition", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "delivery_id": { "type": "string", "pattern": "^DELIVERY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "unit_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "candidate_sha": { "type": "string", "minLength": 1 },
    "pre_sha": { "type": "string", "minLength": 1 },
    "post_sha": { "type": "string", "minLength": 1 },
    "remote_sha": { "type": ["string", "null"], "minLength": 1 },
    "integrator": { "type": "string", "minLength": 1 },
    "verifier": { "type": "string", "minLength": 1 },
    "verification_receipt": { "type": "string", "minLength": 1 },
    "gate_receipts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "push_policy": { "type": "string", "enum": ["no_push", "authorized"] },
    "remote_equality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "evidence_ref"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["not_required", "prepared", "executed", "failed"] },
        "evidence_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "disposition": { "type": "string", "enum": ["landed", "rolled_back", "blocked"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
