{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/ui-decision.schema.json",
  "title": "UI Lab design decision",
  "description": "Durable human decision selecting one reviewed direction and preserving why alternatives were rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "campaign_id",
    "task_id",
    "chosen_direction_id",
    "rejected_direction_ids",
    "rationale",
    "approver",
    "approved_at",
    "review_response",
    "implementation_target",
    "verbatim_notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^DEC-UI-[0-9]{4}-[A-Z0-9][A-Z0-9-]*$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^UI-[0-9]{4}$"
    },
    "task_id": {
      "description": "ID of the canonical task under .agents/tasks.",
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "chosen_direction_id": {
      "$ref": "#/$defs/directionId"
    },
    "rejected_direction_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/directionId"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_response": {
      "$ref": "#/$defs/relativePath"
    },
    "candidate_manifest": {
      "$ref": "#/$defs/relativePath"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "review_response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "implementation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "paths", "acceptance"],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verbatim_notes": {
      "description": "Exact reviewer notes kept separate from interpretation.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "reason", "approved_by"],
        "properties": {
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supersedes": {
      "$ref": "#/$defs/relativePath"
    }
  },
  "$defs": {
    "directionId": {
      "type": "string",
      "pattern": "^DIR-[A-Z0-9][A-Z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+"
    }
  }
}
