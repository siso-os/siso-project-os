{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/lane-state.schema.json",
  "title": "SISO Project OS Sprint Lane State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sprint_id", "lane_id", "owner", "task_ids", "status", "write_fence", "depends_on", "packet_path", "log_seq", "returns", "current_gate", "blocker", "updated_at", "updated_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "sprint_id": { "type": "string", "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "lane_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "owner": { "type": "string", "minLength": 1 },
    "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "status": { "type": "string", "enum": ["ready", "running", "blocked", "returned", "passed", "failed", "cancelled"] },
    "write_fence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "packet_path": { "type": "string", "minLength": 1 },
    "log_seq": { "type": "integer", "minimum": 1 },
    "returns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "current_gate": { "type": ["string", "null"], "minLength": 1 },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["reason", "since"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "since": { "type": "string", "format": "date-time" }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "minLength": 1 }
  }
}
