{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/fleet-domain.schema.json",
  "title": "SISO Project OS Fleet Domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "owner", "owner_role", "verifier_role", "repository_id", "write_paths", "evidence_paths", "worktree_mode", "write_policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "owner": { "type": "string", "minLength": 1 },
    "owner_role": { "type": "string", "enum": ["fleet-pm", "fleet-domain-owner", "fleet-portfolio", "fleet-front-door", "fleet-maintenance"] },
    "verifier_role": { "const": "fleet-verifier" },
    "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "write_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "evidence_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "worktree_mode": { "const": "isolated" },
    "write_policy": { "const": "work-claim-required" }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
