{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/run-event.schema.json",
  "title": "SISO Project OS Run Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "seq", "at", "by", "action"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "by": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "gate_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "minLength": 1 },
    "ref": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 }
  }
}
