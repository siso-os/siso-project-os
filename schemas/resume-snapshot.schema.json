{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/resume-snapshot.schema.json",
  "title": "SISO Project OS Resume Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "objective", "mission_id", "active_task_ids", "active_sprint_id", "active_run_id", "blocker", "next_gate", "evidence_refs", "first_read", "previous_snapshot", "created_at", "created_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^SNAPSHOT-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "mission_id": { "type": ["string", "null"], "pattern": "^MISSION-[a-z0-9][a-z0-9-]*$" },
    "active_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "active_sprint_id": { "type": ["string", "null"], "pattern": "^SPRINT-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "active_run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "blocker": { "type": ["string", "null"], "minLength": 1 },
    "next_gate": { "type": ["string", "null"], "minLength": 1 },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "first_read": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "previous_snapshot": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  }
}
