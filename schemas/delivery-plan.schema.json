{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siso.dev/schemas/project-os/delivery-plan.schema.json",
  "title": "SISO Project OS Delivery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "objective", "task_ids", "run_id", "base_ref", "ordered_refs", "invariants", "conflict_decisions", "regeneration_steps", "gates", "stop_ask_items", "allowed_destination", "push_policy", "created_at", "created_by"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^DELIVERY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "objective": { "type": "string", "minLength": 1 },
    "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-[0-9]{4}$" } },
    "run_id": { "type": ["string", "null"], "pattern": "^RUN-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$" },
    "base_ref": { "type": "string", "minLength": 1 },
    "ordered_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "conflict_decisions": { "type": "array", "items": { "$ref": "#/$defs/conflictDecision" } },
    "regeneration_steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stop_ask_items": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "allowed_destination": { "type": "string", "minLength": 1 },
    "push_policy": { "type": "string", "enum": ["no_push", "authorized"] },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "conflictDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "decision", "rationale"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
