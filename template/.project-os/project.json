{
  "schema_version": 1,
  "project_os_version": "0.5.1",
  "launcher": {
    "schema_version": 2,
    "program": "node",
    "arguments": [
      ".project-os/project-os-launcher.mjs"
    ],
    "cwd": "project-root",
    "source": {
      "transport": "git",
      "repository": {{RUNTIME_REPOSITORY_JSON}},
      "tag": {{RUNTIME_TAG_JSON}},
      "tag_object": {{RUNTIME_TAG_OBJECT_JSON}},
      "commit": {{RUNTIME_COMMIT_JSON}},
      "tree": {{RUNTIME_TREE_JSON}},
      "bin": "bin/siso-project-os.mjs"
    },
    "cache": {
      "scope": "user",
      "key": "tag-object",
      "environment_override": "SISO_PROJECT_OS_CACHE_DIR"
    }
  },
  "project_name": {{PROJECT_NAME_JSON}},
  "project_summary": {{PROJECT_SUMMARY_JSON}},
  "desired_outcome": {{DESIRED_OUTCOME_JSON}},
  "canonical_task_system": "filesystem",
  "external_task_mirror": null,
  "prefixes": {
    "task": "TASK",
    "sprint": "SPRINT",
    "run": "RUN",
    "ui": "UI"
  },
  "generated_dir": ".project-os/generated",
  "verification_commands": [],
  "artifact_policy": {
    "tracked_final_evidence_max_bytes": 5000000,
    "raw_artifacts": "external-or-git-lfs"
  }
}
